*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# Secrets / local env
.env
.env.*
!.env.example

# Editor / OS
.vscode/
.idea/
.DS_Store

