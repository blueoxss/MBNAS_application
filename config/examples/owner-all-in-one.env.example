# MBNAS Research Console 0.1.0 - OWNER ALL-IN-ONE settings: core + owner worker + gateway + runner (+ web) on ONE owner
# host. PRIVATE (owner ZIP only). One file holds the three prefixes MBNAS_CORE_ (mbnas_core.config.CoreSettings),
# MBNAS_GW_ (mbnas_server.config.GatewaySettings) and MBNAS_RUNNER_ (mbnas_runner.config.RunnerSettings); each
# process reads only its own prefix. The three sections below repeat core.env.example, gateway.env.example and
# runner.env.example (same keys, same defaults) - see those files for split (public) deployments.
#
# LOAD THIS FILE ONLY AS A DOTENV FILE, per process:
#   mbnas-core-api --env-file <file>      mbnas-core-owner-worker --owner --env-file <file>
#   mbnas-gateway --env-file <file>       mbnas-runner run --env-file <file>
# Dotenv values stay inside each settings object and never enter the process environment. Do NOT use this file as
# systemd EnvironmentFile=, docker compose env_file: or `set -a; . file`: that would put the core secrets
# (MBNAS_CORE_TICKET_KEY, MBNAS_CORE_API_TOKEN, ...) into the gateway and runner processes. For systemd/compose use
# one file per role (core.env, gateway.env, runner.env).
# MBNAS_HOME is read from the process environment only (scripts/start.sh sets <install root>/runtime).
#
# All-in-one values (everything else: the role sections below):
#   * gateway and runner reach the core on loopback: MBNAS_GW_CORE_URL / MBNAS_RUNNER_CORE_URL keep the default
#     http://127.0.0.1:8700 (plain http is accepted for loopback only);
#   * leave MBNAS_GW_DATASET_ROOTS empty: the gateway forwards validation unchanged and the core checks the dataset
#     paths itself (same host); the runner reads the same paths (MBNAS_RUNNER_DATASET_ROOTS = MBNAS_CORE_DATASET_ROOTS,
#     no MBNAS_RUNNER_DATASET_MOUNTS);
#   * secrets: MBNAS_CORE_API_TOKEN, MBNAS_CORE_ARTIFACT_SIGNING_KEY, MBNAS_CORE_TICKET_KEY, MBNAS_GW_API_TOKEN and
#     MBNAS_GW_ARTIFACT_SIGNING_KEY are GENERATED at install time; MBNAS_GW_CORE_TOKEN and MBNAS_RUNNER_TOKEN are
#     issued by this host's core once its DB exists:
#       mbnas-core-principal --env-file <file> create --kind server
#       mbnas-core-principal --env-file <file> create --kind runner --runner-id <MBNAS_RUNNER_RUNNER_ID>
#     (the token is printed once as JSON; store it here, file mode 0600);
#   * artifacts: MBNAS_RUNNER_ARTIFACT_TRANSFER=local with MBNAS_RUNNER_ARTIFACT_STORE_DIR = MBNAS_GW_ARTIFACT_STORE
#     (default $MBNAS_HOME/gateway/artifacts) lets the gateway serve the runner's artifacts (same host); keep
#     MBNAS_RUNNER_ARTIFACT_STORE_MODE=same-uid when gateway and runner run as one user, else link-0644;
#   * RF-DETR native resume is enabled for the owner's own checkpoints (DD-A20 owner profile).
MBNAS_RUNNER_ALLOW_PICKLE_RESUME=true

#=======================================================================================================================
# CORE  (MBNAS_CORE_*: mbnas-core-api, mbnas-core-owner-worker, mbnas-core-principal, mbnas-core-doctor)
#=======================================================================================================================
# ---- secrets -----------------------------------------------------------------------------------------------------
# GENERATED at install time (python3 -c "import secrets; print(secrets.token_urlsafe(48))"), stored mode 0600.
# An explicitly empty value is rejected at load time: leave a secret commented out instead of writing KEY=.

# REQUIRED to start mbnas-core-api. Bearer token of the optional legacy /api/v1 owner-debug mount
# (MBNAS_CORE_EXPOSE_LEGACY_API=true). Gateways, runners and admins authenticate with scoped principals instead:
#   mbnas-core-principal create --kind server            -> token for the gateway (MBNAS_GW_CORE_TOKEN)
#   mbnas-core-principal create --kind runner --runner-id <id> -> token for that runner (MBNAS_RUNNER_TOKEN)
#   mbnas-core-principal create --kind admin             -> short-lived owner token (/core/v1/owner)
# MBNAS_CORE_API_TOKEN=<GENERATED>

# HMAC key of the signed artifact download URLs issued by the core (required when a signed URL is requested).
# MBNAS_CORE_ARTIFACT_SIGNING_KEY=<GENERATED>

# HMAC-SHA256 key of the per-claim job tickets. Unset: a random key per process start (tickets of running jobs do not
# survive a core restart and a warning is logged) - set it in production.
# MBNAS_CORE_TICKET_KEY=<GENERATED>

# ---- listen address ------------------------------------------------------------------------------------------------
# Keep the core on loopback; expose it to gateways/runners on other hosts only through a TLS reverse proxy (runners
# refuse plain http to a non-loopback core). In a container use 0.0.0.0 and publish the port on 127.0.0.1 only.
# MBNAS_CORE_HOST=127.0.0.1
# MBNAS_CORE_PORT=8700
# Exact browser origins allowed by CORS (scheme://host[:port]; never *). Empty: no cross-origin access (the console
# web app talks to the gateway, not to the core).
# MBNAS_CORE_CORS_ORIGINS=

# ---- storage (defaults under $MBNAS_HOME) --------------------------------------------------------------------------
# SQLite database of runs, candidates, jobs, principals (WAL mode; keep it on a local disk).
# MBNAS_CORE_DB_PATH=/ABSOLUTE/PATH/TO/mbnas_application/runtime/core/db/mbnas.sqlite3
# Core state directory (model registry, validation records, dataset manifests, saved structure documents) and the
# default write allow-root of run outputs. Split deployment: when console.paths.output_root is a customer-host path the
# core host cannot write, the owner worker keeps that run's control files, job logs, generated architecture YAMLs and
# generation journal in <MBNAS_CORE_OUTPUT_ROOT>/<run id>/; the core serves those YAMLs (back this directory up).
# MBNAS_CORE_OUTPUT_ROOT=/ABSOLUTE/PATH/TO/mbnas_application/runtime/core/runs
# Write allow-roots of protocol output paths (console.paths.output_root). Default: [MBNAS_CORE_OUTPUT_ROOT]. When you
# set it, keep MBNAS_CORE_OUTPUT_ROOT inside (core-local generated YAMLs are served only from inside these roots).
# MBNAS_CORE_OUTPUT_ROOTS=/ABSOLUTE/PATH/TO/mbnas_application/runtime/core/runs
# Read allow-roots of datasets checked on this host (at least one; default [$MBNAS_HOME/data]). With a gateway that
# sends its own path checks and manifests (public deployment) the datasets live on the customer host instead.
# MBNAS_CORE_DATASET_ROOTS=/ABSOLUTE/PATH/TO/datasets
# Checkpoint/weights directory of this host (pretrained weights; not a YAML root).
# MBNAS_CORE_WEIGHTS_DIR=/ABSOLUTE/PATH/TO/mbnas_application/runtime/weights
# Read roots of user model YAMLs given by path (used together with MBNAS_CORE_OUTPUT_ROOTS);
# default [$MBNAS_HOME/uploads].
# MBNAS_CORE_MODEL_YAML_ROOTS=/ABSOLUTE/PATH/TO/mbnas_application/runtime/uploads
# Log directory of the core processes.
# MBNAS_CORE_LOG_DIR=/ABSOLUTE/PATH/TO/mbnas_application/runtime/core/logs
# Validation refuses an output root with less free disk than this (GB).
# MBNAS_CORE_MIN_FREE_DISK_GB=5.0
# Interpreter of the owner worker's job children (default: the interpreter running the worker, i.e. the install venv).
# MBNAS_CORE_WORKER_PYTHON=/ABSOLUTE/PATH/TO/venv/bin/python

# ---- API limits and timing -----------------------------------------------------------------------------------------
# Lifetime of a signed artifact URL (s).
# MBNAS_CORE_SIGNED_URL_TTL_S=600
# Job lease length (s) and the heartbeat/sweeper interval (s): a lease not renewed within the TTL is reclaimed.
# MBNAS_CORE_LEASE_TTL_S=60
# MBNAS_CORE_HEARTBEAT_S=10
# Maximum events replayed to an SSE client that reconnects with Last-Event-ID.
# MBNAS_CORE_MAX_REPLAY_EVENTS=5000
# Request body limit of the console routes (bytes; larger -> 413 before the body is read).
# MBNAS_CORE_MAX_REQUEST_BODY_BYTES=1048576
# Request body limit of the /core/v1/runner routes (bytes; 32 MiB).
# MBNAS_CORE_RUNNER_BODY_LIMIT_BYTES=33554432
# Lifetime of a claim ticket (s); it must outlive the longest job attempt (the lease fence still bounds it).
# MBNAS_CORE_TICKET_TTL_S=604800
# Run the sweeper (lease reclaim, runner liveness, idempotency orphans) inside the API process.
# MBNAS_CORE_SWEEPER_ENABLED=true

# ---- runs, devices, retention ---------------------------------------------------------------------------------------
# Device inventory used by protocol validation: local = NVML of this host; runners = devices of registered runners
# (use runners when the GPUs are on runner hosts or the core runs in a container without GPU access). With local and
# no GPU on this host (empty NVML list) the running CPU runners' single 'cpu' entry is used instead: explicit training
# validates, evaluation-ON searches are refused with EVALUATION_REQUIRES_CUDA; GPU runners are never added to local.
# MBNAS_CORE_DEVICE_SOURCE=local
# Default console.retention.full_state when a protocol does not set it: keep_all | rung_end_only | last_rung_end_only.
# MBNAS_CORE_FULL_STATE_RETENTION=keep_all
# Deprecated and ignored since runner protocol 1.1.0 (remote prune round trip): runs of remote runners follow their
# own console.retention.full_state; the latest live full-state checkpoint and checkpoints referenced by evaluation
# rows are never pruned. Kept so that existing configuration files still load.
# MBNAS_CORE_REMOTE_RETENTION_POLICY=keep_all
# Directory holding the PILOT subset (pilot_visdrone_v1) shown as the preset example console.paths. Unset: the presets
# show /ABSOLUTE/PATH/TO/MBNAS_data placeholders.
# MBNAS_CORE_PRESET_DATA_ROOT=/ABSOLUTE/PATH/TO/MBNAS_data
# Directory under which the preset example output roots are placed. Unset: /ABSOLUTE/PATH/TO/MBNAS_runs placeholder.
# MBNAS_CORE_PRESET_OUTPUT_ROOT=/ABSOLUTE/PATH/TO/MBNAS_runs
# Also mount the console routes at /api/v1 behind MBNAS_CORE_API_TOKEN (owner-local debugging only; keep false when a
# gateway serves users - the canonical mount is /core/v1/console, scope server|admin).
# MBNAS_CORE_EXPOSE_LEGACY_API=false

# ---- structure-check sandbox ----------------------------------------------------------------------------------------
# Run explicit structure checks in a subprocess sandbox (rlimits, timeout, minimal env); false = in-process
# (library/tests only).
# MBNAS_CORE_STRUCTURE_SANDBOX=true
# Also sandbox the structure inspection inside PROPOSE_GENERATION children (already isolated child processes).
# MBNAS_CORE_SANDBOX_IN_PROPOSER=false
# Wrap the sandbox in `unshare -rn` (no network) when unprivileged user namespaces are allowed. Docker's default
# seccomp profile usually blocks them; every result records the isolation level actually used (sandbox.isolation).
# MBNAS_CORE_STRUCTURE_CHECK_UNSHARE=true
# Largest input_size an explicit structure check accepts (larger -> 422 INPUT_SIZE_INVALID).
# MBNAS_CORE_STRUCTURE_CHECK_MAX_INPUT=1280
# Wall-clock limit of one check (s; the process group is killed -> STRUCTURE_CHECK_TIMEOUT).
# MBNAS_CORE_STRUCTURE_CHECK_TIMEOUT_S=300.0
# Wait for the single sandbox slot before answering 429 STRUCTURE_CHECK_BUSY (s).
# MBNAS_CORE_STRUCTURE_CHECK_QUEUE_TIMEOUT_S=60.0
# RLIMIT_CPU of the sandbox (CPU seconds over all threads).
# MBNAS_CORE_STRUCTURE_CHECK_CPU_S=900
# RLIMIT_AS of the sandbox (bytes; 8 GiB - torch + ultralytics alone map ~5.3 GiB).
# MBNAS_CORE_STRUCTURE_CHECK_AS_BYTES=8589934592
# RLIMIT_NOFILE of the sandbox.
# MBNAS_CORE_STRUCTURE_CHECK_NOFILE=1024
# RLIMIT_FSIZE of the sandbox (bytes).
# MBNAS_CORE_STRUCTURE_CHECK_FSIZE_BYTES=67108864
# Largest JSON document the sandbox may print (bytes; larger -> STRUCTURE_CHECK_RESOURCE_LIMIT).
# MBNAS_CORE_STRUCTURE_CHECK_MAX_OUTPUT_BYTES=1048576

# ---- owner worker (command-line defaults, read from the process environment; not CoreSettings keys) ----------------
# mbnas-core-owner-worker --owner leases PROPOSE_GENERATION jobs on this host (CPU only; GPU kinds go to runners).
# MBNAS_WORKER_GPU_INDEX=0
# MBNAS_WORKER_GPU_CLEAR_TIMEOUT_S=15

#=======================================================================================================================
# GATEWAY  (MBNAS_GW_*: mbnas-gateway, mbnas-gateway-doctor)
#=======================================================================================================================
# ---- secrets -----------------------------------------------------------------------------------------------------
# An explicitly empty value is rejected at load time: leave a secret commented out instead of writing KEY=.

# REQUIRED (GENERATED at install time: python3 -c "import secrets; print(secrets.token_urlsafe(48))").
# Bearer token of every /api/v1 route: the credential users enter in the web console. The gateway refuses to start
# without it.
# MBNAS_GW_API_TOKEN=<GENERATED>

# REQUIRED to reach the core (ISSUED by the core owner: a server-scope service token for this gateway). Service token
# the gateway presents to the core console API; never sent to browsers.
# MBNAS_GW_CORE_TOKEN=<ISSUED-BY-CORE-OWNER>

# GENERATED at install time. HMAC key of the signed artifact download URLs issued by this gateway.
# MBNAS_GW_ARTIFACT_SIGNING_KEY=<GENERATED>

# ---- listen address and web console --------------------------------------------------------------------------------
# Keep 127.0.0.1 behind a TLS reverse proxy (deploy/public/nginx.example.conf); containers use 0.0.0.0 (compose).
# MBNAS_GW_HOST=127.0.0.1
# MBNAS_GW_PORT=8710
# Built web console served at / (SPA fallback; same origin as /api/v1, so no CORS entry is needed). Default:
# <install root>/mbnas_web/dist when running from the unpacked ZIP, else <current working directory>/mbnas_web/dist.
# MBNAS_GW_WEB_DIST=/ABSOLUTE/PATH/TO/mbnas_application/mbnas_web/dist
# Exact extra browser origins allowed by CORS (scheme://host[:port]; never *), e.g. a separately hosted web build.
# MBNAS_GW_CORS_ORIGINS=https://console.example.org

# ---- upstream core --------------------------------------------------------------------------------------------------
# Base URL of the core (owner host). Use https:// for any non-loopback core (TLS reverse proxy in front of port 8700).
# MBNAS_GW_CORE_URL=https://core.example.org
# A plain http:// core URL to a non-loopback host is refused when the gateway starts (CORE_URL_INSECURE: the service
# token would cross the network in clear text) unless this is set explicitly; https:// and loopback http:// are
# always accepted.
# MBNAS_GW_CORE_ALLOW_INSECURE_HTTP=false
# Path prefix of the core console API (keep the default; /api/v1 only for a legacy-exposing owner-debug core).
# MBNAS_GW_CORE_PREFIX=/core/v1/console
# Verify the core TLS certificate; MBNAS_GW_CORE_CA_FILE adds a private CA bundle (PEM).
# MBNAS_GW_CORE_TLS_VERIFY=true
# MBNAS_GW_CORE_CA_FILE=/ABSOLUTE/PATH/TO/core-ca.pem
# Connect timeout and read timeout (s) of relayed calls (validation and structure checks are synchronous on core).
# MBNAS_GW_CORE_CONNECT_TIMEOUT_S=5.0
# MBNAS_GW_CORE_READ_TIMEOUT_S=120.0
# Silence on the core event stream longer than this ends the browser stream (s; core heartbeats every 15 s).
# MBNAS_GW_CORE_SSE_READ_TIMEOUT_S=60.0
# Gateway-side SSE heartbeat when core sent nothing for this long (s).
# MBNAS_GW_SSE_HEARTBEAT_S=15.0

# ---- data on this host (validate pre-processing, uploads) -----------------------------------------------------------
# REQUIRED for a public deployment: read allow-roots of the datasets on THIS host. The gateway checks
# console.paths here, reads the dataset YAML and sends path checks + per-split manifests to the core (the core never
# reads customer files). Empty: validate is forwarded unchanged and the core checks paths itself (owner all-in-one).
# MBNAS_GW_DATASET_ROOTS=/ABSOLUTE/PATH/TO/datasets
# Allow-roots of console.paths.output_root checked on this host (REQUIRED together with MBNAS_GW_DATASET_ROOTS:
# empty = every output_root is refused); also read roots (with MBNAS_GW_MODEL_YAML_ROOTS) of a user model YAML given
# by model_path. Note: the core keeps run documents and generated architectures under
# <console.paths.output_root>/<run id> ON THE CORE HOST and re-checks that path against its own output allow-roots
# (a mismatch is refused when the run is created), so the output_root a user enters must be acceptable to both hosts
# (e.g. the same absolute path on both).
# MBNAS_GW_OUTPUT_ROOTS=/ABSOLUTE/PATH/TO/mbnas_runs
# Read allow-roots of user model YAMLs given by model_path (the gateway sends core the YAML text, never a path).
# MBNAS_GW_MODEL_YAML_ROOTS=/ABSOLUTE/PATH/TO/model_yamls
# Dataset manifest cache: <root>/manifests (default $MBNAS_HOME/gateway).
# MBNAS_GW_MANIFEST_CACHE_ROOT=/ABSOLUTE/PATH/TO/mbnas_application/runtime/gateway
# Free disk (GB) reported with the output_root check (0 = no minimum on this side).
# MBNAS_GW_MIN_FREE_DISK_GB=0.0
# Largest model-config upload (bytes; at most 16 MiB).
# MBNAS_GW_UPLOAD_MAX_BYTES=1048576
# Request body limit of the other /api/v1 routes (bytes; larger -> 413 before the body is read).
# MBNAS_GW_MAX_REQUEST_BODY_BYTES=1048576

# ---- artifacts and logs (defaults under $MBNAS_HOME) ----------------------------------------------------------------
# Customer-side artifact store (model-config uploads, content addressed, and artifact bytes served by the gateway).
# MBNAS_GW_ARTIFACT_STORE=/ABSOLUTE/PATH/TO/mbnas_application/runtime/gateway/artifacts
# Lifetime of a signed artifact URL (s).
# MBNAS_GW_SIGNED_URL_TTL_S=600
# Size cap of one stored artifact object (bytes; default 4 GiB).
# MBNAS_GW_ARTIFACT_MAX_BYTES=4294967296
# Downloads up to this size are hashed completely before the response starts (a digest mismatch is a clean 409
# LOAD_FAILED); larger objects are verified while they stream, so a mismatch aborts the body after it started - compare
# the X-Artifact-Sha256 header. Also the per-object limit of the export zip (bytes; default 64 MiB).
# MBNAS_GW_ARTIFACT_VERIFY_FIRST_MAX_BYTES=67108864
# Log directory and the sensitive-read audit log (JSON lines).
# MBNAS_GW_LOG_DIR=/ABSOLUTE/PATH/TO/mbnas_application/runtime/gateway/logs
# MBNAS_GW_AUDIT_LOG=/ABSOLUTE/PATH/TO/mbnas_application/runtime/gateway/logs/audit.jsonl

# ---- rate limits (per token) ----------------------------------------------------------------------------------------
# MBNAS_GW_RATE_LIMIT_ENABLED=true
# Sustained requests per second and burst size of one token on /api.
# MBNAS_GW_RATE_LIMIT_RPS=10.0
# MBNAS_GW_RATE_LIMIT_BURST=50
# Expensive routes (POST validate, structure-check, training-runs; GET export): concurrent calls and calls
# started per rolling minute, per token.
# MBNAS_GW_EXPENSIVE_CONCURRENCY=1
# MBNAS_GW_EXPENSIVE_PER_MINUTE=30
# Open event streams (SSE) per token.
# MBNAS_GW_SSE_MAX_PER_TOKEN=4

# ---- read-only research archive (optional; default off) ------------------------------------------------------------
# Absolute directories whose sub-directories are yolo_ga_full run directories, served read-only by /api/v1/archive.
# Never written. Empty = archive routes answer 503 ARCHIVE_ROOT_UNAVAILABLE.
# MBNAS_GW_ARCHIVE_ROOTS=/ABSOLUTE/PATH/TO/archive_runs
# Pipeline driver directories holding STATUS.json / pipeline.log (read-only, /archive/live).
# MBNAS_GW_ARCHIVE_DRIVER_DIRS=/ABSOLUTE/PATH/TO/driver_dir
# 12-search campaign roots (campaign.json + arms/<space>/<method>/<seed>/), or directories of such roots.
# MBNAS_GW_ARCHIVE_CAMPAIGN_ROOTS=/ABSOLUTE/PATH/TO/campaign_root
# Seconds before cached archive scans are re-validated against file mtime/size (0 = always re-check).
# MBNAS_GW_ARCHIVE_CACHE_TTL_S=5.0

#=======================================================================================================================
# RUNNER  (MBNAS_RUNNER_*: mbnas-runner)
#=======================================================================================================================
# ---- core connection and identity -----------------------------------------------------------------------------------
# Base URL of the core. Plain http:// is accepted ONLY for a loopback core (127.0.0.1, ::1, localhost); any other
# host needs https:// (the daemon refuses to start: CORE_URL_INSECURE).
# MBNAS_RUNNER_CORE_URL=https://core.example.org
# REQUIRED (ISSUED by the core owner: a runner-scope token bound to MBNAS_RUNNER_RUNNER_ID). Give either the token
# itself or MBNAS_RUNNER_TOKEN_FILE (first line of a 0600 file); an explicit token wins over the file.
# An explicitly empty value is rejected: leave the line commented out instead of writing KEY=.
# MBNAS_RUNNER_TOKEN=<ISSUED-BY-CORE-OWNER>
# MBNAS_RUNNER_TOKEN_FILE=/ABSOLUTE/PATH/TO/runner.token
# Runner id; must equal the --runner-id the token was issued for. Default (unset): a random runner-<8 hex> created on
# first use and kept in $MBNAS_HOME/runner/runner_id (never derived from the host name; never replaced automatically).
# scripts/install.sh creates it and prints the id the core owner must issue the token for
# (mbnas-core-principal create --kind runner --runner-id <that id>).
# Upgrade note: a token issued for the old default runner-<hostname> now answers RUNNER_MISMATCH - set
# MBNAS_RUNNER_RUNNER_ID to the id the token was issued for, or have a new token issued for the generated id.
# MBNAS_RUNNER_RUNNER_ID=runner-0a1b2c3d
# CA bundle (PEM) that verifies the core's TLS certificate (private CA); unset = the system trust store.
# MBNAS_RUNNER_CA_FILE=/ABSOLUTE/PATH/TO/core-ca.pem
# Job kinds this runner claims (subset of BASELINE_TRAIN, CANDIDATE_TRAIN, FINAL_RETRAIN, EVALUATE, BENCHMARK).
# MBNAS_RUNNER_KINDS=BASELINE_TRAIN,CANDIDATE_TRAIN,FINAL_RETRAIN,EVALUATE,BENCHMARK

# ---- device ---------------------------------------------------------------------------------------------------------
# CUDA index of the GPU this runner uses (CUDA_VISIBLE_DEVICES of its job children). In a container with one reserved
# GPU it is always 0.
# CPU runner: start the daemon with CUDA_VISIBLE_DEVICES= (set and EMPTY) in its process environment (not a key of
# this file); it then registers device "cpu" and runs training, checkpoints and structure work on the CPU. Evaluation
# latency needs CUDA, so CPU evaluations stay latency_source=pending (no EVALUATED rows from a CPU runner).
# MBNAS_RUNNER_GPU_INDEX=0
# The job children run with CUDA_DEVICE_ORDER=PCI_BUS_ID (CUDA numbering = nvidia-smi/NVML numbering). Set the same in
# the environment of scripts you run by hand on this host (e.g. scripts/runner/bench_host_gpu.py) so a GPU index means
# the same device everywhere. Not a key of this file.
# Seconds to wait for the GPU to be free of foreign processes before a job starts (0 = do not wait).
# MBNAS_RUNNER_GPU_CLEAR_TIMEOUT_S=15.0

# ---- data and storage (defaults under $MBNAS_HOME) -----------------------------------------------------------------
# Directory this runner writes job runs to (journal, checkpoints, logs of children).
# MBNAS_RUNNER_WORK_ROOT=/ABSOLUTE/PATH/TO/mbnas_application/runtime/runner/runs
# Roots a run directory may live below (default: [MBNAS_RUNNER_WORK_ROOT]).
# MBNAS_RUNNER_OUTPUT_ROOTS=/ABSOLUTE/PATH/TO/mbnas_application/runtime/runner/runs
# Read allow-roots of datasets on this host (at least one; default [$MBNAS_HOME/data]).
# MBNAS_RUNNER_DATASET_ROOTS=/ABSOLUTE/PATH/TO/datasets
# Dataset path mapping {path in the resolved protocol: path on this host} when the protocol's dataset paths (as
# validated) are not the paths on this host; every local path is also added to the dataset allow-roots.
# MBNAS_RUNNER_DATASET_MOUNTS='{"/ABSOLUTE/PATH/IN/PROTOCOL/datasets": "/ABSOLUTE/PATH/TO/datasets"}'
# Pretrained weights / checkpoint directory (RF-DETR weights live in <dir>/rfdetr unless RF_HOME is set).
# MBNAS_RUNNER_WEIGHTS_DIR=/ABSOLUTE/PATH/TO/mbnas_application/runtime/weights
# Log directory of the daemon.
# MBNAS_RUNNER_LOG_DIR=/ABSOLUTE/PATH/TO/mbnas_application/runtime/runner/logs
# Interpreter of the job children (default: the interpreter running the daemon, i.e. the install venv).
# MBNAS_RUNNER_WORKER_PYTHON=/ABSOLUTE/PATH/TO/venv/bin/python

# ---- artifact transfer to the gateway store ---------------------------------------------------------------------
# none (default): files stay in the runner work root; local: every registered artifact (checkpoints, images, logs) is
# hard-linked, else copied, into the gateway's artifact store on THIS host (content addressed <store>/<sha[:2]>/<sha>),
# so the gateway can serve downloads. Use local whenever gateway and runner share a host (docker compose: shared
# runtime/ volume). upload (runner -> gateway over HTTP) is reserved and refused in 0.1.0.
# MBNAS_RUNNER_ARTIFACT_TRANSFER=none
# The gateway's artifact store directory on this host (= MBNAS_GW_ARTIFACT_STORE, default
# $MBNAS_HOME/gateway/artifacts); required when MBNAS_RUNNER_ARTIFACT_TRANSFER=local.
# MBNAS_RUNNER_ARTIFACT_STORE_DIR=/ABSOLUTE/PATH/TO/mbnas_application/runtime/gateway/artifacts
# Permission bits of what local mode stores (checkpoints are written 0600; a hard link shares the inode):
#   same-uid  (default) the gateway runs as this runner's user (docker compose: both services use MBNAS_UID);
#   link-0644 the gateway runs as another user: a linked file not readable by others is set to 0644 (its run-directory
#             twin with it), copies are 0644;
#   copy-0644 the gateway runs as another user and run-directory files keep their bits: such files are copied 0644.
# Same-host example: MBNAS_RUNNER_ARTIFACT_TRANSFER=local, MBNAS_RUNNER_ARTIFACT_STORE_DIR = MBNAS_GW_ARTIFACT_STORE,
# MBNAS_RUNNER_ARTIFACT_STORE_MODE=same-uid (one service user for both) or link-0644 (two users).
# MBNAS_RUNNER_ARTIFACT_STORE_MODE=same-uid
# Tries per registered file before it is recorded as abandoned (retries follow the heartbeat with backoff).
# MBNAS_RUNNER_ARTIFACT_TRANSFER_MAX_TRIES=6
# Reserved for the upload mode (not implemented in 0.1.0; never read): gateway base URL and upload token file.
# MBNAS_RUNNER_GATEWAY_URL=https://gateway.example.org
# MBNAS_RUNNER_GATEWAY_UPLOAD_TOKEN_FILE=/ABSOLUTE/PATH/TO/gateway-upload.token

# ---- job control ----------------------------------------------------------------------------------------------------
# Heartbeat interval while a job runs (s); the core may negotiate its own value at registration.
# MBNAS_RUNNER_HEARTBEAT_S=10
# Grace between SIGTERM and SIGKILL when a job child is stopped (s).
# MBNAS_RUNNER_KILL_GRACE_S=10.0
# Stop the child when its lease ran out on the core's clock without a renewal.
# MBNAS_RUNNER_KILL_ON_LEASE_EXPIRY=true
# Progress batching: at most one batch per interval (s, minimum 1) and at most this many messages per batch.
# MBNAS_RUNNER_PROGRESS_INTERVAL_S=1.0
# MBNAS_RUNNER_MAX_BATCH_MESSAGES=100
# Idle poll interval for new jobs (s).
# MBNAS_RUNNER_POLL_S=2.0
# HTTP retry policy towards the core: retries, initial backoff (s), per-request timeout (s).
# MBNAS_RUNNER_REQUEST_RETRIES=5
# MBNAS_RUNNER_REQUEST_BACKOFF_S=0.5
# MBNAS_RUNNER_REQUEST_TIMEOUT_S=30.0
# RF-DETR native resume unpickles a full checkpoint (torch.load(weights_only=False)): off by default on customer
# runners; enable only for checkpoints you trust (the digest is still checked). The owner profile enables it.
# MBNAS_RUNNER_ALLOW_PICKLE_RESUME=false   (set to true at the top of this file)
